class CFont
{
	static CFont *New(const std::string ident, CGraphicPtr g);
	static CFont *Get(const std::string ident);
	void SetAuthoredHeight(int height);
	void SetAuthoredSize(int width, int height);
	void SetAuthoredHud(int height);
	void SetSpaceAdvance(int authoredPx);
	void SetLineHeight(int authoredPx);
	void SetHudShadow(int units);
	void SetCodePage(int page);
	std::string WrapLine(int line, const std::string text, int maxWidth);

	int Height();
	int Width(const std::string text);
};


#define MaxFontColors 9

class CFontColor
{
	static CFontColor *New(const std::string ident);
	static CFontColor *Get(const std::string ident);

	SDL_Color Colors[MaxFontColors];
};

