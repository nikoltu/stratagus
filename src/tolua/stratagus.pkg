$pfile "sound.pkg"
$pfile "translate.pkg"
$pfile "trigger.pkg"
$pfile "ui.pkg"
$pfile "unit.pkg"
$pfile "unittype.pkg"
$pfile "upgrade.pkg"
$pfile "video.pkg"

extern int SaveGame(const std::string filename);
extern bool DeleteSaveGame(const std::string filename);

extern std::string Translate @ _(const std::string str);

extern int SyncRand(void);
extern int SyncRand(int max);
extern bool CanAccessFile(const char *filename);

// CF8: the Remastered's own campaign-progress store (GlobalSave.json). Keys are the
// original's: "todOrc", "todHuman", "bdpOrc", "bdpHuman".
$#include "globalsave.h"
$#include "wc2strings.h"
// TX1..TX9: the Remastered's own text (Data/Strings/<lang>.json), read from the player's
// installation. RM_Str(key) returns "" when the key or the file is absent.
extern const std::string &GetWC2String @ RM_Str(const std::string key);
extern int GetWC2Id @ RM_Id(const std::string family, const std::string displayName);
// The id of an object by its ident ("unit-orc-shipyard", "upgrade-sword1", "spell-healing"):
// RM_SetId fills the registry the command tooltip reads, RM_IdOf returns -1 for an unknown ident.
extern void SetWC2IdForIdent @ RM_SetId(const std::string family, const std::string ident, int id);
extern int GetWC2IdForIdent @ RM_IdOf(const std::string family, const std::string ident);
extern void SetGlobalCampaignProgress(const std::string campaignKey, int missionsCompleted);

// Result record of a game started by a launch request (scripts/launch.lua).
$#include "launchresult.h"
extern bool WriteLaunchResult(const std::string text);
extern bool WriteLaunchLoading(const std::string text);
extern unsigned long LastGameCycle;

// Messages to and commands from the activity hosting the engine.
$#include "launcher_bridge.h"
extern void LauncherPost(int what, int value);
extern int LauncherPollCommand();
void Exit(int err);

$extern std::string CliMapName;
extern std::string CliMapName;
extern std::string StratagusLibPath;
extern bool IsDebugEnabled;
